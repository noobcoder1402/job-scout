# Copy this file to .env and fill in your keys
# cp .env.example .env

# Required: your Anthropic API key (used for AI matching)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for custom career pages (Ashby, Workday, etc.)
# Get a free key at: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: used as fallback for finding careers URLs
# Get a key at: https://exa.ai
EXA_API_KEY=your_exa_api_key_here
